# Copy this file to .env.local and fill in your values

# ── Claude / Anthropic ──────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL. For local dev, use Docker, Postgres.app, or a hosted DB.
# On Vercel, use Vercel Postgres / Neon / Supabase — set DATABASE_URL in project env.
DATABASE_URL="postgresql://user:password@localhost:5432/sms_dev?schema=public"

# ── App URL ─────────────────────────────────────────────────────────────────
# Used in Teams notification cards to link back to reports
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Microsoft 365 — Teams Incoming Webhook ───────────────────────────────────
# Create a webhook in Teams: Channel → Connectors → Incoming Webhook
# High/Critical risk reports are posted here automatically when a report is confirmed.
TEAMS_WEBHOOK_URL=https://forit.webhook.office.com/webhookb2/...

# ── Microsoft 365 — Azure AD App Registration (optional, for Graph API) ─────
# Required for: Teams channel messages via Graph API, SharePoint archival
# App needs: ChannelMessage.Send (delegated) + Files.ReadWrite.All (application)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# For Teams channel messages via Graph API (alternative to webhook)
TEAMS_TEAM_ID=your-team-id
TEAMS_CHANNEL_ID=your-channel-id

# For SharePoint archival
SHAREPOINT_SITE_ID=your-site-id
SHAREPOINT_DRIVE_ID=your-drive-id
